# ---------------------------------------------------------------------------
# FootballIQ environment variables
# Copy this file to ".env" and fill in the values before running the app.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# When running with docker-compose, the bundled database is reachable at:
DATABASE_URL="postgresql://postgres:postgres@db:5432/football_iq?connect_timeout=15"
# For a locally installed Postgres instead, use something like:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/football_iq?connect_timeout=15"

# football-data.org API token — powers the league standings.
# Get a free key at https://www.football-data.org/client/register
FOOTBALL_DATA_KEY="your_football_data_org_key"

# The Odds API key — powers upcoming-match predictions and recent results.
# Get a free key at https://the-odds-api.com/
ODDS_API_KEY="your_odds_api_key"
